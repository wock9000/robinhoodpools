[Unit]
Description=RobinhoodPools public LP explorer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=6

[Service]
Type=simple
WorkingDirectory=%h/robinhoodpools
Environment=PYTHONUNBUFFERED=1
Environment=LP_RPC_DISABLE_LOCAL_FALLBACK=1
Environment=LP_RPC_DISABLE_ALCHEMY=1
# Holder gate. Uncomment and pin the owner EOA before the policy can be signed.
#Environment=RHP_GATE_OWNER=0x0000000000000000000000000000000000000000
#Environment=RHP_GATE_RPC_URL=http://127.0.0.1:8547
#Environment=RHP_GATE_DB=%h/.local/share/rhpools/gate.sqlite
#Environment=RHP_TX_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
#EnvironmentFile=-%h/.secrets/rhpools/listener.env
ExecStart=%h/robinhoodpools/.venv/bin/rhpools --host 127.0.0.1 --port 8196 --public-origin https://rhpools.lol --public-origin https://www.rhpools.lol --public-origin https://robinhoodpools.lol --public-origin https://www.robinhoodpools.lol
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
LimitNOFILE=8192
NoNewPrivileges=true
InaccessiblePaths=-%h/.secrets
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
